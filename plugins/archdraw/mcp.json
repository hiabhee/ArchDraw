{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "archdraw": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "exec",
        "--yes",
        "--package=@hiabhee/archdraw-mcp-server@1.0.3",
        "--",
        "archdraw-mcp-server"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "API_BASE_URL": "https://archdraw.hiabhee.online"
      }
    }
  }
}
