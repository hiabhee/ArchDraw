{
  "description": "ArchDraw live projects: report which files this session edits (paths only) to the linked ArchDraw project canvas. Does nothing unless the repository was linked with `archdraw-mcp-server link`.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/archdraw-project.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/archdraw-project.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/archdraw-project.mjs\" hook", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/archdraw-project.mjs\" hook", "timeout": 5 }
        ]
      }
    ]
  }
}
