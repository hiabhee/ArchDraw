# ArchDraw Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Core Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production

# AI Services
GROQ_API_KEY=your-groq-api-key-here

# Jev AI (server-side architecture-decision testing)
# JEV_API_KEY=sk_your_jev_api_key_here
# JEV_LANGUAGE=en-US
# JEV_API_BASE_URL=https://thejevai.com
# JEV_MODEL=typesafe/jev-1.13

# Optional: Multiple Groq API Keys for load balancing
# GROQ_API_KEY_FOR_DESC_1=your-first-groq-key
# GROQ_API_KEY_FOR_DESC_2=your-second-groq-key
# ... up to GROQ_API_KEY_FOR_DESC_10

# AI capacity guardrails (provider/account limits; tune from observed usage)
# AI_GLOBAL_TPM_LIMIT=12000
# AI_GLOBAL_RPM_LIMIT=30
# AI_QUEUE_MAX_DEPTH=30
# AI_MAX_ACTIVE_JOBS=2
# AI_ADMISSION_SAFETY_FACTOR=0.85
# AI_L1_MAX_TOKENS=2048
# AI_L2_MAX_TOKENS=3072
# AI_L3_MAX_TOKENS=4096
# AI_REPAIR_MAX_TOKENS=2048
# AI_JOB_TTL_SECONDS=900

# Optional: OpenRouter API Keys for fallback
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_API_KEY_1=your-first-openrouter-key
# OPENROUTER_API_KEY_2=your-second-openrouter-key

# Database (PostgreSQL — e.g., Supabase)
# Use the Pooler connection string (Supavisor, port 6543, transaction mode) for serverless deploys
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Redis Cache (e.g., Upstash)
# UPSTASH_REDIS_REST_URL=your-redis-url
# UPSTASH_REDIS_REST_TOKEN=your-redis-token

# OAuth Providers (Optional - for social login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Admin Configuration (Optional - for admin panel)
# ADMIN_PASSCODE=your-admin-passcode
# ADMIN_SESSION_SECRET=your-admin-session-secret

# Vercel Cron auth for /api/cron/* (e.g. daily expired-share cleanup).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Unset = cron routes return 401.
# CRON_SECRET=generate-a-long-random-string
# ADMIN_USER_ID=your-admin-user-id
# ALLOWED_ADMIN_EMAIL=admin@yourdomain.com

# Public Configuration
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com

# Embed Security (Optional - restrict which domains can embed diagrams)
# Comma-separated allowlist of domains permitted to iframe the /embed viewer.
# ALLOWED_EMBED_DOMAINS=example.com,another.com
# If not set, defaults to SAME-ORIGIN ONLY (no third-party embedding).
# Set to "*" to explicitly allow embedding from anywhere.
# ALLOWED_EMBED_DOMAINS=*

# GitHub Integration (Optional - for repo diagram generation)
# GITHUB_TOKEN=your-github-token

# Development Settings
NEXT_PUBLIC_AUTH_ENABLED=true
NODE_ENV=development

# Repository Analysis Settings (Optional)
# REPO_LLM_MODEL=llama-3.3-70b-versatile
# REPO_CLASSIFIER_MAX_TOKENS=2000
# REPO_EXTRACTOR_MAX_TOKENS=4000
# REPO_RELATIONSHIP_MAX_TOKENS=5000

# Cache Settings (Optional)
# ARCHIVE_CACHE_SIZE=25

# Debug Settings (Optional)
# NEXT_PUBLIC_DEBUG_EDGES=false
