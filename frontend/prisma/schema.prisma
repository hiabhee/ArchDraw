generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════
// Better Auth Models
// ═══════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Application relations (repointed from auth.users)
  profile          Profile?
  userCanvases     UserCanvas[]
  tutorialProgress TutorialProgress[]
  visitor          Visitor?           @relation(fields: [visitorId], references: [id])
  visitorId        String?            @db.Uuid
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([accountId, providerId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ═══════════════════════════════════════════════════════════════════
// Application Tables
// ═══════════════════════════════════════════════════════════════════

model Profile {
  id         String    @id // FK → User.id (Better Auth)
  email      String?
  fullName   String?   @map("full_name")
  avatarUrl  String?   @map("avatar_url")
  provider   String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserCanvas {
  id        String   @id // text PK, not auto-generated
  userId    String   @map("user_id")
  name      String   @default("Canvas 1")
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_canvases")
}

model TutorialProgress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id")
  tutorialId      String   @map("tutorial_id")
  currentLevel    Int      @default(1) @map("current_level")
  currentStep     Int      @default(1) @map("current_step")
  currentPhase    String   @default("context") @map("current_phase")
  completedLevels Int[]    @default([]) @map("completed_levels")
  canvasNodes     Json     @default("[]") @map("canvas_nodes")
  canvasEdges     Json     @default("[]") @map("canvas_edges")
  explainCount    Int      @default(0) @map("explain_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialId])
  @@map("tutorial_progress")
}

model SharedCanvas {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvasName String   @map("canvas_name")
  nodes      Json
  edges      Json
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @default(dbgenerated("(now() + interval '30 days')")) @map("expires_at")

  @@map("shared_canvases")
}

model TutorialResponseCache {
  questionHash String   @id @map("question_hash")
  response     String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tutorial_response_cache")
}

model ComponentCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  color        String?  @default("#94a3b8")
  icon         String?
  displayOrder Int?     @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  templates ComponentTemplate[]

  @@map("component_categories")
}

model ComponentTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String?  @map("category_id")
  name        String
  description String?
  color       String?  @default("#94a3b8")
  icon        String?
  technology  String?
  createdAt   DateTime @default(now()) @map("created_at")

  category ComponentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@map("component_templates")
}

model Visitor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anonId        String   @unique @map("anon_id")
  userId        String?  @map("user_id")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  firstReferrer String?  @map("first_referrer")
  firstUtm      Json?    @map("first_utm")
  userAgent     String?  @map("user_agent")
  country       String?
  isInternal    Boolean? @default(false) @map("is_internal")

  sessions VisitorSession[]
  events   Event[]
  users    User[]

  @@index([anonId])
  @@index([userId])
  @@map("visitors")
}

model VisitorSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId       String    @map("visitor_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  entryPage       String?   @map("entry_page")
  exitPage        String?   @map("exit_page")
  deviceType      String?   @map("device_type")

  visitor Visitor @relation(fields: [visitorId], references: [id])
  events  Event[]

  @@index([visitorId])
  @@index([startedAt(sort: Desc)])
  @@map("sessions")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @map("session_id")
  visitorId String   @map("visitor_id")
  eventType String   @map("event_type")
  eventName String?  @map("event_name")
  pagePath  String?  @map("page_path")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  session VisitorSession @relation(fields: [sessionId], references: [id])
  visitor Visitor        @relation(fields: [visitorId], references: [id])

  @@index([sessionId])
  @@index([visitorId])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("events")
}
