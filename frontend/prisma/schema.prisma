generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String              @id
  name                   String
  email                  String              @unique
  emailVerified          Boolean             @default(false)
  image                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime
  visitorId              String?             @db.Uuid
  dailyGenerations       Int                 @default(0) @map("daily_generations")
  dailyGenerationsDate   DateTime            @default(now()) @map("daily_generations_date")
  featureFlags           Json                @default("{}") @map("feature_flags")
  totalGenerations       Int                 @default(0) @map("total_generations")
  Account                Account[]
  Session                Session[]
  visitors               Visitor?            @relation(fields: [visitorId], references: [id])
  profiles               Profile?
  sharedCanvases         SharedCanvas[]
  tutorialProgress       TutorialProgress[]
  usageLogs              UsageLog[]
  userCanvases           UserCanvas[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([identifier, value])
}

model ComponentCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  color         String?  @default("#94a3b8")
  icon          String?
  displayOrder  Int?     @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")

  templates ComponentTemplate[]

  @@map("component_categories")
}

model ComponentTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String?  @map("category_id")
  name        String
  description String?
  color       String?  @default("#94a3b8")
  icon        String?
  technology  String?
  createdAt   DateTime @default(now()) @map("created_at")

  category ComponentCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("component_templates")
}

model Event {
  id        BigInt  @id @default(autoincrement())
  sessionId String  @map("session_id")
  visitorId String  @map("visitor_id")
  eventType String  @map("event_type")
  eventName String? @map("event_name")
  pagePath  String? @map("page_path")
  payload   Json    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  visitor Visitor @relation(fields: [visitorId], references: [id])
  session VisitorSession @relation(fields: [sessionId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([visitorId])
  @@map("events")
}

model Profile {
  id           String    @id
  email        String?
  full_name    String?
  avatar_url   String?
  provider     String?
  created_at   DateTime  @default(now())
  last_seen_at DateTime?
  User         User      @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model VisitorSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId       String    @map("visitor_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  entryPage       String?   @map("entry_page")
  exitPage        String?   @map("exit_page")
  deviceType      String?   @map("device_type")

  visitor Visitor @relation(fields: [visitorId], references: [id])
  events  Event[]

  @@index([startedAt(sort: Desc)])
  @@index([visitorId])
  @@map("sessions")
}

model SharedCanvas {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvasName      String   @map("canvas_name")
  nodes           Json
  edges           Json
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @default(dbgenerated("(now() + '30 days'::interval)")) @map("expires_at")
  accessType      String   @default("anyone") @map("access_type")
  linkPermission  String   @default("viewer") @map("link_permission")
  users           Json     @default("[]")
  ownerId         String?  @map("owner_id")
  User            User?    @relation(fields: [ownerId], references: [id])

  @@map("shared_canvases")
}

model TutorialProgress {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id")
  tutorialId       String   @map("tutorial_id")
  currentLevel     Int      @default(1) @map("current_level")
  currentStep      Int      @default(1) @map("current_step")
  currentPhase     String   @default("context") @map("current_phase")
  completedLevels  Int[]    @default([]) @map("completed_levels")
  canvasNodes      Json     @default("[]") @map("canvas_nodes")
  canvasEdges      Json     @default("[]") @map("canvas_edges")
  explainCount     Int      @default(0) @map("explain_count")
  updatedAt        DateTime @default(now()) @map("updated_at")
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialId])
  @@map("tutorial_progress")
}

model TutorialResponseCache {
  questionHash String   @id @map("question_hash")
  response     String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tutorial_response_cache")
}

model UsageLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id")
  guestId   String?  @map("guest_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  User      User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([guestId, createdAt])
  @@index([userId, createdAt])
  @@map("usage_logs")
}

model UserCanvas {
  id        String   @id
  userId    String   @map("user_id")
  name      String   @default("Canvas 1")
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_canvases")
}

model Visitor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anonId         String    @unique @map("anon_id")
  userId         String?   @map("user_id")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  firstReferrer  String?   @map("first_referrer")
  firstUtm       Json?     @map("first_utm")
  userAgent      String?   @map("user_agent")
  country        String?
  isInternal     Boolean?  @default(false) @map("is_internal")
  User           User[]
  sessions       VisitorSession[]
  events         Event[]

  @@index([anonId])
  @@index([userId])
  @@map("visitors")
}
