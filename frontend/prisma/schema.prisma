generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String              @id
  name                   String
  email                  String              @unique
  emailVerified          Boolean             @default(false)
  image                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime
  visitorId              String?             @db.Uuid
  daily_generations      Int                 @default(0)
  daily_generations_date DateTime            @default(now())
  feature_flags          Json                @default("{}")
  total_generations      Int                 @default(0)
  Account                Account[]
  Session                Session[]
  visitors               visitors?           @relation(fields: [visitorId], references: [id])
  profiles               profiles?
  shared_canvases        shared_canvases[]
  tutorial_progress      tutorial_progress[]
  usage_logs             usage_logs[]
  user_canvases          user_canvases[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([identifier, value])
}

model component_categories {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  color         String?  @default("#94a3b8")
  icon          String?
  display_order Int?     @default(0)
  created_at    DateTime @default(now())
}

model component_templates {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id String?
  name        String
  description String?
  color       String?  @default("#94a3b8")
  icon        String?
  technology  String?
  created_at  DateTime @default(now())

  @@index([category_id])
}

model events {
  id         BigInt   @id @default(autoincrement())
  session_id String
  visitor_id String
  event_type String
  event_name String?
  page_path  String?
  payload    Json     @default("{}")
  created_at DateTime @default(now())

  @@index([created_at(sort: Desc)])
  @@index([event_type, created_at(sort: Desc)])
  @@index([session_id])
  @@index([visitor_id])
}

model profiles {
  id           String    @id
  email        String?
  full_name    String?
  avatar_url   String?
  provider     String?
  created_at   DateTime  @default(now())
  last_seen_at DateTime?
  User         User      @relation(fields: [id], references: [id], onDelete: Cascade)
}

model sessions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id       String
  started_at       DateTime  @default(now())
  ended_at         DateTime?
  duration_seconds Int?
  entry_page       String?
  exit_page        String?
  device_type      String?

  @@index([started_at(sort: Desc)])
  @@index([visitor_id])
}

model shared_canvases {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvas_name     String
  nodes           Json
  edges           Json
  created_at      DateTime @default(now())
  expires_at      DateTime @default(dbgenerated("(now() + '30 days'::interval)"))
  access_type     String   @default("anyone")
  link_permission String   @default("viewer")
  users           Json     @default("[]")
  owner_id        String?
  User            User?    @relation(fields: [owner_id], references: [id])
}

model tutorial_progress {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String
  tutorial_id      String
  current_level    Int      @default(1)
  current_step     Int      @default(1)
  current_phase    String   @default("context")
  completed_levels Int[]    @default([])
  canvas_nodes     Json     @default("[]")
  canvas_edges     Json     @default("[]")
  explain_count    Int      @default(0)
  updated_at       DateTime
  User             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tutorial_id])
}

model tutorial_response_cache {
  question_hash String   @id
  response      String
  created_at    DateTime @default(now())
}

model usage_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?
  guest_id   String?
  action     String
  metadata   Json?
  created_at DateTime @default(now())
  User       User?    @relation(fields: [user_id], references: [id])

  @@index([action, created_at])
  @@index([guest_id, created_at])
  @@index([user_id, created_at])
}

model user_canvases {
  id         String   @id
  user_id    String
  name       String   @default("Canvas 1")
  nodes      Json     @default("[]")
  edges      Json     @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model visitors {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anon_id        String   @unique
  user_id        String?
  first_seen_at  DateTime @default(now())
  last_seen_at   DateTime @default(now())
  first_referrer String?
  first_utm      Json?
  user_agent     String?
  country        String?
  is_internal    Boolean? @default(false)
  User           User[]

  @@index([anon_id])
  @@index([user_id])
}
