generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String                  @id
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  visitorId              String?                 @db.Uuid
  dailyGenerations       Int                     @default(0) @map("daily_generations")
  dailyGenerationsDate   DateTime                @default(now()) @map("daily_generations_date")
  featureFlags           Json                    @default("{}") @map("feature_flags")
  totalGenerations       Int                     @default(0) @map("total_generations")
  Account                Account[]
  Session                Session[]
  visitors               Visitor?                @relation(fields: [visitorId], references: [id])
  profiles               Profile?
  sharedCanvases         SharedCanvas[]
  tutorialProgress       TutorialProgress[]
  usageLogs              UsageLog[]
  userCanvases           UserCanvas[]
  agenticProjects        AgenticProject[]
  agenticCredentials     AgenticCredential[]
  agenticPairingRequests AgenticPairingRequest[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model ComponentCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  color        String?  @default("#94a3b8")
  icon         String?
  displayOrder Int?     @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  templates ComponentTemplate[]

  @@map("component_categories")
}

model ComponentTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  name        String
  description String?
  color       String?  @default("#94a3b8")
  icon        String?
  technology  String?
  createdAt   DateTime @default(now()) @map("created_at")

  category ComponentCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("component_templates")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @map("session_id") @db.Uuid
  visitorId String   @map("visitor_id") @db.Uuid
  eventType String   @map("event_type")
  eventName String?  @map("event_name")
  pagePath  String?  @map("page_path")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  visitor Visitor        @relation(fields: [visitorId], references: [id])
  session VisitorSession @relation(fields: [sessionId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([visitorId])
  @@map("events")
}

model Profile {
  id           String    @id
  email        String?
  full_name    String?
  avatar_url   String?
  provider     String?
  created_at   DateTime  @default(now())
  last_seen_at DateTime?
  User         User      @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model VisitorSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId       String    @map("visitor_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  entryPage       String?   @map("entry_page")
  exitPage        String?   @map("exit_page")
  deviceType      String?   @map("device_type")

  visitor Visitor @relation(fields: [visitorId], references: [id])
  events  Event[]

  @@index([startedAt(sort: Desc)])
  @@index([visitorId])
  @@map("sessions")
}

model SharedCanvas {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvasName     String   @map("canvas_name")
  nodes          Json
  edges          Json
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @default(dbgenerated("(now() + '30 days'::interval)")) @map("expires_at")
  accessType     String   @default("anyone") @map("access_type")
  linkPermission String   @default("viewer") @map("link_permission")
  users          Json     @default("[]")
  ownerId        String?  @map("owner_id")
  revision       Int      @default(1)
  mcpUpdateToken String?  @unique @map("mcp_update_token")
  User           User?    @relation(fields: [ownerId], references: [id])

  @@map("shared_canvases")
}

model TutorialProgress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id")
  tutorialId      String   @map("tutorial_id")
  currentLevel    Int      @default(1) @map("current_level")
  currentStep     Int      @default(1) @map("current_step")
  currentPhase    String   @default("context") @map("current_phase")
  completedLevels Int[]    @default([]) @map("completed_levels")
  canvasNodes     Json     @default("[]") @map("canvas_nodes")
  canvasEdges     Json     @default("[]") @map("canvas_edges")
  explainCount    Int      @default(0) @map("explain_count")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialId])
  @@map("tutorial_progress")
}

model TutorialResponseCache {
  questionHash String   @id @map("question_hash")
  response     String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("tutorial_response_cache")
}

model UsageLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id")
  guestId   String?  @map("guest_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  User      User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([guestId, createdAt])
  @@index([userId, createdAt])
  @@map("usage_logs")
}

model UserCanvas {
  id               String          @id
  userId           String          @map("user_id")
  name             String          @default("Canvas 1")
  nodes            Json            @default("[]")
  edges            Json            @default("[]")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  /// Set when the canvas is a live project; the agentic project anchors agent credentials.
  agenticProjectId String?         @unique @map("agentic_project_id") @db.Uuid
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agenticProject   AgenticProject? @relation(fields: [agenticProjectId], references: [id], onDelete: SetNull)
  agentSessions    AgentSession[]
  detailMap        ProjectDetailMap?
  componentHistory ComponentActivity[]

  @@index([userId])
  @@map("user_canvases")
}

/// Detailed map of a live project: each overview component as a box of its
/// modules/files. Separate from the canvas row so writing it never bumps the
/// canvas updatedAt (no false save conflicts) and canvas lists stay small.
model ProjectDetailMap {
  canvasId  String     @id @map("canvas_id")
  nodes     Json       @default("[]")
  edges     Json       @default("[]")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  canvas    UserCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@map("project_detail_maps")
}

/// History of a live project's components: one row per work bout (a session's
/// run of edits on one component) or per component a session added. Kept
/// longer than sessions so a component's history outlives them.
model ComponentActivity {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvasId          String   @map("canvas_id")
  componentId       String   @map("component_id")
  /// Part of the detailed map the files belong to, when one is drawn.
  detailComponentId String?  @map("detail_component_id")
  sessionKey        String   @map("session_key")
  sessionName       String?  @map("session_name")
  /// edit | added
  kind              String
  /// What the session said it was doing (`intent`), if it said.
  intent            String?
  /// Repository-relative paths edited in this bout (most recent last, capped).
  files             Json     @default("[]")
  edits             Int      @default(0)
  startedAt         DateTime @default(now()) @map("started_at")
  lastAt            DateTime @default(now()) @map("last_at")

  canvas UserCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId, componentId, lastAt(sort: Desc)])
  @@index([canvasId, sessionKey, lastAt(sort: Desc)])
  @@map("component_activity")
}

/// One coding-agent session (e.g. a Claude Code session) reporting activity on a project canvas.
model AgentSession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canvasId           String   @map("canvas_id")
  sessionKey         String   @map("session_key")
  label              String
  branch             String?
  status             String   @default("active")
  intent             String?
  currentComponentId String?  @map("current_component_id")
  touched            Json     @default("{}")
  unmappedPaths      Json     @default("[]") @map("unmapped_paths")
  /// Last structural diagram change this session published ({added, removed, renamed, at}).
  lastChange         Json?    @map("last_change")
  /// What the session did last: start | read | edit | waiting | done (drives the canvas figure).
  lastAction         String?  @map("last_action")
  lastActionAt       DateTime? @map("last_action_at")
  /// Component the session's task is about (matched locally from the prompt; the prompt is never sent).
  aimComponentId     String?  @map("aim_component_id")
  /// Short name shown on the map and in the session's terminal ("Otter"); distinct among a canvas's live sessions.
  name               String?
  /// Folder of new code no component owns that the session is editing (drawn as a construction site).
  siteArea           String?  @map("site_area")
  /// Component the construction site is drawn next to.
  siteAnchorId       String?  @map("site_anchor_id")
  /// Part of the detailed map the session is at (null: use currentComponentId).
  detailComponentId  String?  @map("detail_component_id")
  /// Edited source files that were / were not on a component (map coverage).
  mappedHits         Int      @default(0) @map("mapped_hits")
  unmappedHits       Int      @default(0) @map("unmapped_hits")
  startedAt          DateTime @default(now()) @map("started_at")
  lastSeenAt         DateTime @default(now()) @map("last_seen_at")

  canvas UserCanvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@unique([canvasId, sessionKey])
  @@index([canvasId, lastSeenAt(sort: Desc)])
  @@map("agent_sessions")
}

model AgenticProject {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String   @map("owner_id")
  name             String
  repositoryRemote String?  @map("repository_remote")
  defaultBranch    String?  @map("default_branch")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaces      AgenticWorkspace[]
  credentials     AgenticCredential[]
  pairingRequests AgenticPairingRequest[]
  canvas          UserCanvas?

  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("agentic_projects")
}

model AgenticWorkspace {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  bindingKey      String   @map("binding_key") @db.Uuid
  branchName      String?  @map("branch_name")
  baseCommitSha   String?  @map("base_commit_sha")
  currentRevision Int      @default(0) @map("current_revision")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project         AgenticProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions       AgenticArchitectureRevision[]
  views           AgenticProjectView[]
  proposals       AgenticProposal[]
  pairingRequests AgenticPairingRequest[]

  @@unique([projectId, bindingKey])
  @@index([projectId, branchName])
  @@map("agentic_workspaces")
}

model AgenticArchitectureRevision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  revision      Int
  baseCommitSha String?  @map("base_commit_sha")
  snapshot      Json     @default("{\"components\":[],\"relationships\":[]}")
  summary       String?
  actorType     String   @default("user") @map("actor_type")
  actorId       String?  @map("actor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace AgenticWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, revision])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("agentic_architecture_revisions")
}

model AgenticProjectView {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  viewType    String   @default("overview") @map("view_type")
  state       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace AgenticWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("agentic_project_views")
}

model AgenticProposal {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  baseRevision Int      @map("base_revision")
  title        String
  summary      String?
  operations   Json     @default("[]")
  status       String   @default("draft")
  decision     Json?
  verification Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace AgenticWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("agentic_proposals")
}

model AgenticCredential {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String    @map("owner_id")
  projectId  String    @map("project_id") @db.Uuid
  name       String    @default("ArchDraw agent")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project AgenticProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("agentic_credentials")
}

model AgenticPairingRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userCodeHash  String    @unique @map("user_code_hash")
  pollTokenHash String    @map("poll_token_hash")
  status        String    @default("pending")
  ownerId       String?   @map("owner_id")
  projectId     String?   @map("project_id") @db.Uuid
  workspaceId   String?   @map("workspace_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  approvedAt    DateTime? @map("approved_at")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  owner     User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project   AgenticProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace AgenticWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("agentic_pairing_requests")
}

model Visitor {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anonId        String           @unique @map("anon_id")
  userId        String?          @map("user_id")
  firstSeenAt   DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime         @default(now()) @map("last_seen_at")
  firstReferrer String?          @map("first_referrer")
  firstUtm      Json?            @map("first_utm")
  userAgent     String?          @map("user_agent")
  country       String?
  isInternal    Boolean?         @default(false) @map("is_internal")
  User          User[]
  sessions      VisitorSession[]
  events        Event[]

  @@index([anonId])
  @@index([userId])
  @@map("visitors")
}
