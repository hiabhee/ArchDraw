{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "dev:frontend": "next dev",
    "dev:mcp": "cd ../mcp-server && npx tsx src/index.ts",
    "postinstall": "prisma generate",
    "prebuild": "npm run mcp:build",
    "build": "next build",
    "build:all": "npm run build && npm run mcp:build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "mcp:dev": "cd ../mcp-server && npx tsx src/index.ts",
    "mcp:build": "npx tsc -p ../mcp-server/tsconfig.json",
    "eval:repo": "tsx scripts/eval/run-eval.ts",
    "eval:repo:report": "tsx scripts/eval/run-eval.ts --report",
    "eval:golden": "tsx scripts/eval/gen-golden.ts",
    "eval:test": "vitest --run scripts/eval/__tests__/score.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.8",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@reactflow/node-resizer": "^2.2.14",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dom2svg": "^1.0.12",
    "elkjs": "^0.11.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^0.9.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
