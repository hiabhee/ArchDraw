{
  "name": "@hiabhee/archdraw-mcp-server",
  "version": "1.0.5",
  "description": "MCP server for ArchDraw architecture diagramming tool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "archdraw-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/copy-widget.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "archdraw",
    "architecture",
    "diagram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiabhee/ArchDraw.git"
  },
  "license": "MIT"
}
